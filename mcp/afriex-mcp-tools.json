    {
      "name": "create_transaction",
      "description": "Create a new transaction. WITHDRAW sends funds to a destination payment method (requires customerId and destinationId). DEPOSIT pulls funds from a source payment method (requires customerId and sourceId). SWAP converts funds between currencies within the Afriex wallet \u2014 only sourceCurrency, destinationCurrency, sourceAmount, and meta are required. Type defaults to WITHDRAW if not specified.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "description": "The unique identifier of the customer. Required for DEPOSIT and WITHDRAW. Not required for SWAP."
          },
          "type": {
            "type": "string",
            "enum": [
              "DEPOSIT",
              "WITHDRAW",
              "SWAP"
            ],
            "description": "Transaction type. WITHDRAW sends funds to a destination (requires destinationId). DEPOSIT pulls funds from a source (requires sourceId). Defaults to WITHDRAW."
          },
          "sourceAmount": {
            "type": "string",
            "description": "Amount in the source currency"
          },
          "destinationAmount": {
            "type": "string",
            "description": "Amount in the destination currency"
          },
          "sourceCurrency": {
            "type": "string",
            "minLength": 1,
            "description": "ISO 4217 currency code of the source (e.g. USD, NGN)"
          },
          "destinationCurrency": {
            "type": "string",
            "minLength": 1,
            "description": "ISO 4217 currency code of the destination (e.g. USD, NGN)"
          },
          "destinationId": {
            "type": "string",
            "description": "Required for WITHDRAW transactions. The ID of the destination payment method that money will be sent to."
          },
          "sourceId": {
            "type": "string",
            "description": "Required for DEPOSIT transactions. The ID of the source payment method that money will be pulled from."
          },
          "meta": {
            "type": "object",
            "properties": {
              "narration": {
                "type": "string"
              },
              "invoice": {
                "type": "string"
              },
              "idempotencyKey": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              },
              "merchantId": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "Optional metadata (narration, invoice, idempotencyKey, reference, merchantId)"
          }
        },
        "required": [
          "sourceCurrency",
          "destinationCurrency"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_transactions",
      "description": "Retrieve a paginated list of transactions. Supports filtering by transactionId, reference, status, type, channel, currency, and date range.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0,
            "description": "Page number (starting from 0, default 0)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Number of items per page (1-50, default 10)"
          },
          "transactionId": {
            "type": "string",
            "description": "Filter by the Afriex transactionId"
          },
          "reference": {
            "type": "string",
            "description": "Filter by merchant-supplied meta.reference"
          },
          "status": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PENDING",
                "PROCESSING",
                "SUCCESS",
                "FAILED",
                "CANCELLED",
                "REFUNDED",
                "RETRY",
                "UNKNOWN",
                "SCHEDULED",
                "CUSTOMER_ACTION_REQUIRED",
                "REJECTED",
                "IN_REVIEW",
                "DISPUTED",
                "DISPUTE_RESOLVED",
                "DISPUTE_WON",
                "DISPUTE_LOST",
                "DISPUTE_EVIDENCE_SUBMITTED"
              ]
            },
            "description": "Filter by one or more transaction statuses"
          },
          "type": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "DEPOSIT",
                "WITHDRAW",
                "SWAP",
                "REVERSAL",
                "SCHEDULED",
                "SEND"
              ]
            },
            "description": "Filter by one or more transaction types"
          },
          "channel": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "BANK_ACCOUNT",
                "MOBILE_MONEY",
                "CARD",
                "CRYPTO",
                "VIRTUAL_BANK_ACCOUNT",
                "ACH_BANK_ACCOUNT",
                "INTERAC",
                "PAYBILL_TILL",
                "RFP",
                "UPI",
                "VIRTUAL_CARD",
                "SWIFT",
                "WE_CHAT",
                "ALIPAY",
                "WALLET"
              ]
            },
            "description": "Filter by one or more payment channels"
          },
          "currency": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Filter by one or more ISO 4217 currency codes"
          },
          "fromDate": {
            "type": "string",
            "format": "date-time",
            "description": "Return transactions created on or after this ISO 8601 datetime"
          },
          "toDate": {
            "type": "string",
            "format": "date-time",
            "description": "Return transactions created on or before this ISO 8601 datetime"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
