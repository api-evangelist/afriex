            "maxLength": 3,
            "pattern": "^[A-Z]{3}$",
            "description": "Uppercase 3-letter ISO 4217 currency code (e.g. NGN)"
          },
          "merchantReference": {
            "type": "string",
            "minLength": 1,
            "description": "Unique merchant-supplied reference for this session"
          },
          "redirectUrl": {
            "type": "string",
