    {
      "name": "create_customer",
      "description": "Create a new customer with name, email, phone, and country code. Optionally include KYC and metadata.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1,
            "description": "Full name of the customer"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the customer"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+\\d{7,15}$",
            "description": "Phone number in E.164 format (e.g. +2348192837465)"
          },
          "countryCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code (e.g. NG, US, GB, KE)"
          },
          "kyc": {
            "type": "object",
            "additionalProperties": {},
            "description": "Optional KYC document details"
          },
          "meta": {
            "type": "object",
            "additionalProperties": {},
            "description": "Optional metadata to attach to the customer"
          }
        },
        "required": [
          "fullName",
          "email",
          "phone",
          "countryCode"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
