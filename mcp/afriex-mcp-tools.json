    {
      "name": "create_payment_method",
      "description": "Create a new payment method for a customer. Supports BANK_ACCOUNT, SWIFT, MOBILE_MONEY, UPI, INTERAC, and WE_CHAT channels. Institution requires at least institutionCode or institutionName.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "BANK_ACCOUNT",
              "SWIFT",
              "MOBILE_MONEY",
              "UPI",
              "INTERAC",
              "WE_CHAT"
            ],
            "description": "The payment method channel"
          },
          "customerId": {
            "type": "string",
            "minLength": 1,
            "description": "The unique identifier of the customer"
          },
          "type": {
            "type": "string",
            "enum": [
              "DEPOSIT",
              "WITHDRAW"
            ],
            "description": "Transaction capability. DEPOSIT = pull funds, WITHDRAW = send funds. Defaults to WITHDRAW."
          },
          "accountName": {
            "type": "string",
            "minLength": 1,
            "description": "Name of the account holder"
          },
          "accountNumber": {
            "type": "string",
            "minLength": 1,
            "description": "The account number"
          },
          "countryCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code"
          },
          "institution": {
            "type": "object",
            "properties": {
              "institutionId": {
                "type": "string"
              },
              "institutionName": {
                "type": "string"
              },
              "institutionCode": {
                "type": "string"
              },
              "institutionAddress": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "Bank or provider details"
          },
          "recipient": {
            "type": "object",
            "properties": {
              "recipientEmail": {
                "type": "string"
              },
              "recipientPhone": {
                "type": "string"
              },
              "recipientAddress": {
                "type": "string"
              },
              "recipientName": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "Recipient details"
          },
          "transaction": {
            "type": "object",
            "properties": {
              "transactionInvoice": {
                "type": "string"
              },
              "transactionNarration": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "Transaction metadata"
          }
        },
        "required": [
          "channel",
          "customerId",
          "accountName",
          "accountNumber",
          "countryCode",
          "institution"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
